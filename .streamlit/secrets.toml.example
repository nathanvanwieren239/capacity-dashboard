# Copy this file to `secrets.toml` in the same folder and set real passwords.
# `secrets.toml` is gitignored and must never be committed.
#
# On Streamlit Community Cloud, do NOT upload a file - paste these lines
# into: app menu -> Settings -> Secrets.
#
# Two dummy login types for the development build:
#   viewer -> read only
#   editor -> also gets the Add New Gate Zero / Add New Prototype forms

APP_PASSWORD_VIEWER = "viewer"
APP_PASSWORD_EDITOR = "editor"
